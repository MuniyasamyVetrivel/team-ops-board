# Production settings for docker-compose.prod.yml (docs/deployment.md).
# Copy to .env.prod on the server, fill in every CHANGE_ME, and keep it readable by its owner only:
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
# .env.prod is git-ignored. Never commit it, and keep a copy of the secrets (above all BACKUP_ENCRYPTION_KEY) in the
# company password manager: without that key no backup can be restored.
#
# Fixed by the image or the "prod" profile, so not listed here: the CORS origin (https://ops.tritusa.com.au), the
# Secure refresh cookie, actuator health only, the upload folder, the local backup folder and mysqldump path.

# --- Release ---
# The image tag the stack runs: the git commit or release you built (docs/deployment.md, "Update" and "Rollback").
APP_VERSION=CHANGE_ME
# cloudflared release tag, e.g. 2025.8.0 (https://github.com/cloudflare/cloudflared/releases); update monthly.
CLOUDFLARED_VERSION=CHANGE_ME

# --- Cloudflare Tunnel ---
# Zero Trust -> Networks -> Tunnels -> your tunnel -> Docker install command: the long token after --token.
TUNNEL_TOKEN=CHANGE_ME

# --- MySQL (the mysql container creates the database team_ops_board and this user on first start) ---
DB_USERNAME=teamops
# Generate with: openssl rand -base64 32 | tr -d '/+='
DB_PASSWORD=CHANGE_ME
# Used only by the restore tools (creating a database needs root). Generate the same way, different value.
MYSQL_ROOT_PASSWORD=CHANGE_ME

# --- JWT ---
# At least 32 bytes, or the backend refuses to start. Generate with: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=CHANGE_ME
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7

# --- First Super Admin (used only while the users table is empty; docs/go-live-data.md) ---
# The password (12+ characters) is temporary and must be changed at first sign-in. Blank BOOTSTRAP_ADMIN_PASSWORD
# again after the first start and run `up -d` so it is no longer in the container's environment.
BOOTSTRAP_ADMIN_EMAIL=CHANGE_ME
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
BOOTSTRAP_ADMIN_FIRST_NAME=CHANGE_ME
BOOTSTRAP_ADMIN_LAST_NAME=CHANGE_ME
BOOTSTRAP_ADMIN_DEPARTMENT_CODE=IT
BOOTSTRAP_ADMIN_EMPLOYEE_ID=CHANGE_ME

# --- App ---
APP_TIME_ZONE=Asia/Kolkata
# Must match Nginx's client_max_body_size (10m): uploads above it are refused.
FILE_MAX_SIZE_MB=10
COMPANY_NAME=Tritusa

# --- Background jobs (Spring cron, evaluated in APP_TIME_ZONE) ---
APP_SCHEDULING_ENABLED=true
TASK_REMINDER_CRON=0 0 8 * * *
MARKETING_ACTIVITY_CRON=0 10 0 * * *
CELEBRATION_REMINDER_CRON=0 0 8 * * *
BENCH_REMINDER_CRON=0 15 8 * * *
VENDOR_REMINDER_CRON=0 20 8 * * *
FINANCE_REMINDER_CRON=0 25 8 * * *
RECYCLE_BIN_PURGE_CRON=0 30 2 * * *

# --- Backups (docs/backup-and-restore.md) ---
# First copy: the "backups" Docker volume on this instance (fixed in docker-compose.prod.yml).
# Second copy: a Lightsail object storage bucket in Sydney, with an access key created for that bucket only.
BACKUP_ENABLED=true
BACKUP_CRON=0 0 2 * * *
# Base64 of 32 random bytes. Generate with: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=CHANGE_ME
BACKUP_SECONDARY_TARGET=S3
BACKUP_SECONDARY_S3_BUCKET=CHANGE_ME
BACKUP_SECONDARY_S3_PREFIX=backups
BACKUP_SECONDARY_S3_REGION=ap-southeast-2
BACKUP_SECONDARY_S3_ENDPOINT=https://s3.ap-southeast-2.amazonaws.com
# Lightsail -> Storage -> your bucket -> Permissions -> Access keys -> Create access key (scoped to this bucket).
BACKUP_SECONDARY_S3_ACCESS_KEY=CHANGE_ME
BACKUP_SECONDARY_S3_SECRET_KEY=CHANGE_ME
BACKUP_SECONDARY_S3_PATH_STYLE=false
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=12
BACKUP_MAX_AGE_HOURS=26
