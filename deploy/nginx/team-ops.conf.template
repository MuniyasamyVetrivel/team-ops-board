# Team Ops Board: the single-page app and the /api proxy, served on 8080 inside the Compose network only.
# Traffic arrives from cloudflared (Cloudflare Tunnel) on the "edge" network; Cloudflare terminates TLS for
# https://ops.tritusa.com.au. frontend/Dockerfile renders this template (frontend/scripts/nginx-conf.ts fills in the
# CSP script hashes) into /etc/nginx/conf.d/default.conf.

server {
    # IPv4 only: the Compose networks are IPv4, and an IPv6 listen fails where the kernel has IPv6 switched off.
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    absolute_redirect off;
    charset utf-8;

    # Uploads: matches the backend's FILE_MAX_SIZE_MB=10 (a larger file gets 413 here, before it reaches Java).
    client_max_body_size 10m;

    # Real client IP: only cloudflared on the "edge" network (172.28.0.0/24) reaches Nginx, and it passes on the
    # visitor's address from Cloudflare in CF-Connecting-IP. Any other sender's header is ignored.
    set_real_ip_from 172.28.0.0/24;
    real_ip_header CF-Connecting-IP;
    real_ip_recursive off;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/csv application/javascript application/json application/xml
               application/manifest+json image/svg+xml;

    # Security headers on every response (no location below adds its own headers, so these are never dropped).
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' __INLINE_SCRIPT_HASHES__; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    # Docker's DNS, re-resolved every 10 s, so a recreated backend container (new IP) is found without a reload.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend http://backend:8080;

    location /api/ {
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # Replace, never append: the backend trusts this header from Nginx only (application-prod.yml).
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        # Downloads ("Export all data", CSV exports, attachments) stream straight through instead of filling /tmp.
        proxy_buffering off;
        proxy_request_buffering on;
        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # Content-hashed build output: cache for a year.
    location /assets/ {
        expires 1y;
        access_log off;
        try_files $uri =404;
    }

    # Liveness for the container health check (not reachable from outside the Compose network).
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The backend's actuator is internal; never serve it (or anything like it) through the public site.
    location /actuator {
        return 404;
    }

    # Client-side routes: every other path is the app. index.html is never cached, so a release shows at once.
    location / {
        expires -1;
        try_files $uri /index.html;
    }
}
