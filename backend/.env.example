# Copy to backend/.env and fill in real values. backend/.env is git-ignored.

# --- Database (MySQL 8) ---
DB_URL=jdbc:mysql://localhost:3306/team_ops_board?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=teamops
DB_PASSWORD=change-me

# --- JWT ---
# At least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-bytes
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7
# true in any HTTPS environment; false only for plain-http local development
REFRESH_COOKIE_SECURE=false

# --- CORS (comma separated) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Demo data: lives only in the automated tests, so it can never be loaded by the app. Keep false. ---
DEV_SEED_ENABLED=false

# --- First Super Admin for a fresh, empty database (see docs/go-live-data.md) ---
# Used only when the users table is empty. The password (12+ characters) is temporary: it must be changed at first
# sign-in. Remove BOOTSTRAP_ADMIN_PASSWORD after the first start.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=
BOOTSTRAP_ADMIN_DEPARTMENT_CODE=IT
# Required: every user has an employee ID (letters, digits, . - _ /; up to 40 characters).
BOOTSTRAP_ADMIN_EMPLOYEE_ID=

# --- Files ---
FILE_STORAGE_DIR=./uploads
FILE_MAX_SIZE_MB=20

# --- Business time zone (due today / overdue are evaluated here) ---
APP_TIME_ZONE=Asia/Kolkata

# --- Server ---
# SERVER_PORT=8080
# Behind a reverse proxy: take the client IP for audit logs from X-Forwarded-For (internal proxies only).
# SERVER_FORWARD_HEADERS_STRATEGY=native

# --- Background jobs ---
# Daily task due-soon / overdue reminders (Spring cron, evaluated in APP_TIME_ZONE). Set APP_SCHEDULING_ENABLED=false to disable.
APP_SCHEDULING_ENABLED=true
TASK_REMINDER_CRON=0 0 8 * * *
# Daily recurring marketing activity job: creates the current period's occurrences and tasks.
MARKETING_ACTIVITY_CRON=0 10 0 * * *
# Daily birthday / work anniversary / important day / event reminders, run and dated in APP_TIME_ZONE.
# How many days ahead is the Admin Settings value "Reminder days before" (default 2).
CELEBRATION_REMINDER_CRON=0 0 8 * * *
# Daily permanent delete of recycle bin items older than the Admin Settings retention (default 90 days).
RECYCLE_BIN_PURGE_CRON=0 30 2 * * *

# --- Backups (docs/backup-and-restore.md) ---
# Nightly encrypted backup of the database and the uploads folder, at BACKUP_CRON in APP_TIME_ZONE.
BACKUP_ENABLED=true
BACKUP_CRON=0 0 2 * * *
# Base64 of 32 random bytes. Keep a copy somewhere safe outside the server: without it no backup can be restored.
# Generate with: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=change-me-base64-of-32-random-bytes
# mysqldump from MySQL 8.4, e.g. C:/Program Files/MySQL/MySQL Server 8.4/bin/mysqldump.exe or /usr/bin/mysqldump
MYSQLDUMP_PATH=mysqldump
# LOCAL: a folder outside the project. S3: Amazon S3 or Lightsail object storage (fill in BACKUP_S3_*).
BACKUP_TARGET=LOCAL
BACKUP_LOCAL_PATH=D:/team-ops-backups
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups
BACKUP_S3_REGION=
# Blank for AWS S3. Lightsail object storage: https://s3.<region>.amazonaws.com
BACKUP_S3_ENDPOINT=
# Blank to use the server's IAM role / default AWS credentials.
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_PATH_STYLE=false
# Optional second copy of every backup (another folder, disk or bucket): LOCAL, S3, or blank for none.
# Each copy is verified on its own; the status page and health check report each copy separately.
BACKUP_SECONDARY_TARGET=
BACKUP_SECONDARY_LOCAL_PATH=E:/team-ops-backups-copy
BACKUP_SECONDARY_S3_BUCKET=
BACKUP_SECONDARY_S3_PREFIX=backups
BACKUP_SECONDARY_S3_REGION=
BACKUP_SECONDARY_S3_ENDPOINT=
BACKUP_SECONDARY_S3_ACCESS_KEY=
BACKUP_SECONDARY_S3_SECRET_KEY=
BACKUP_SECONDARY_S3_PATH_STYLE=false
# Retention: the newest backup of each of the last 30 days and of each of the last 12 months is kept.
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=12
# The health check flags a problem when the last successful backup is older than this or the last run failed.
BACKUP_MAX_AGE_HOURS=26
# Where a backup is assembled before it is copied to the target (blank: the system temp folder).
BACKUP_WORK_DIR=

# --- Calendar celebrations ---
# Shown on work anniversaries, e.g. "5 years at Tritusa".
COMPANY_NAME=Tritusa
