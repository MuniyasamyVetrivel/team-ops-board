# Copy to frontend/.env if you need to override defaults. Not secret - bundled into the browser build.

# API base URL. Default "/api" goes through the Vite dev proxy (vite.config.ts) to http://localhost:8080.
# For a deployed build pointing at another host, set the full URL, e.g. https://ops.example.com/api
VITE_API_BASE_URL=/api
